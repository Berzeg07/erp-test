# Shared local infra
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5443

# Server (Swagger / pnpm dev). Vitest switches this URL to schema=test and does not wipe public.
DATABASE_URL=postgresql://app:app@localhost:5443/app?schema=public
# Optional: point tests at another database instead of schema=test
# TEST_DATABASE_URL=postgresql://app:app@localhost:5443/app_test?schema=public
JWT_SECRET=change-me-in-production-min-16
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
SERVER_HOST=0.0.0.0
SERVER_PORT=4101
CORS_ORIGIN=http://localhost:5283
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_TIME_WINDOW_MS=60000

# Super admin (created by pnpm db:seed)
SUPERADMIN_EMAIL=admin@app.local
SUPERADMIN_PASSWORD=admin12345
SUPERADMIN_DISPLAY_NAME=Admin
