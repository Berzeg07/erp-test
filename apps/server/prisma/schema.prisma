generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  moderator
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole @default(user)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  approvals     Approval[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Tenant {
  id                 String   @id @default(uuid())
  slug               String   @unique
  name               String
  llmTokenBudget     Int      @default(10000)
  llmTokenSpent      Int      @default(0)
  killSwitchOn       Boolean  @default(false)
  killSwitchReason   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rawLeadRecords RawLeadRecord[]
  people         Person[]
  companies      Company[]
  companyContacts CompanyContact[]
  leadCases      LeadCase[]
  suppressionEntries SuppressionEntry[]
  decisionRecords DecisionRecord[]
  drafts          Draft[]
  draftVersions   DraftVersion[]
  approvals       Approval[]
  outboxMessages  OutboxMessage[]
}

enum LeadCaseStatus {
  QUALIFY
  REJECT
  MANUAL_REVIEW
}

enum DeliveryGuard {
  CLEAR
  BLOCKED
}

enum ProcessingBasis {
  CONSENT
  DOCUMENTED_LEGITIMATE_INTEREST
  UNKNOWN
  PROHIBITED
}

model Person {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identityKey     String
  emailNormalized String?
  displayName     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  companyContacts CompanyContact[]
  leadCases       LeadCase[]

  @@unique([tenantId, identityKey])
  @@index([tenantId])
}

model Company {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  nameNormalized String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  domains     CompanyDomain[]
  externalIds CompanyExternalId[]
  contacts    CompanyContact[]
  leadCases   LeadCase[]

  @@index([tenantId])
  @@index([tenantId, nameNormalized])
}

model CompanyDomain {
  id        String  @id @default(uuid())
  tenantId  String
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  domain    String

  @@unique([tenantId, domain])
  @@index([companyId])
}

model CompanyExternalId {
  id         String  @id @default(uuid())
  tenantId   String
  companyId  String
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source     String
  externalId String

  @@unique([tenantId, source, externalId])
  @@index([tenantId, externalId])
  @@index([companyId])
}

model CompanyContact {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personId  String
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadCases LeadCase[]

  @@unique([tenantId, personId, companyId])
  @@index([tenantId])
}

model LeadCase {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personId         String
  person           Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyContactId String
  companyContact   CompanyContact @relation(fields: [companyContactId], references: [id], onDelete: Cascade)
  status           LeadCaseStatus   @default(MANUAL_REVIEW)
  deliveryGuard    DeliveryGuard    @default(CLEAR)
  deliveryGuardReason String?
  processingBasis  ProcessingBasis  @default(UNKNOWN)
  processingBasisEvidenceRefs Json @default("[]")
  sourcePurpose    String           @default("")
  mergeBy          String           @default("none")
  score            Int              @default(0)
  confidence       Float            @default(0)
  policyVersion    String           @default("rules-v1")
  conflicts        Json
  reasons          Json
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  rawRecords       RawLeadRecord[]
  decisionRecord   DecisionRecord?
  draft            Draft?
  outboxMessages   OutboxMessage[]

  @@unique([tenantId, personId, companyId])
  @@index([tenantId])
}

model RawLeadRecord {
  id         String    @id @default(uuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source     String
  externalId String
  fixtureId  String?
  payload    Json
  leadCaseId String?
  leadCase   LeadCase? @relation(fields: [leadCaseId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([tenantId, source, externalId])
  @@index([tenantId])
  @@index([leadCaseId])
}

model SuppressionEntry {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailNormalized String
  reason          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, emailNormalized])
  @@index([tenantId])
}

model DecisionRecord {
  id                  String         @id @default(uuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCaseId          String         @unique
  leadCase            LeadCase       @relation(fields: [leadCaseId], references: [id], onDelete: Cascade)
  policyVersion       String
  status              LeadCaseStatus
  deliveryGuard       DeliveryGuard
  deliveryGuardReason String?
  score               Int
  confidence          Float
  reasons             Json
  evidenceRefs        Json
  ruleOutput          Json
  llmOutput           Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([tenantId])
}

model Draft {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCaseId String   @unique
  leadCase   LeadCase @relation(fields: [leadCaseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  versions DraftVersion[]

  @@index([tenantId])
}

model DraftVersion {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draftId       String
  draft         Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  versionNumber Int
  subject       String
  body          String
  channel       String
  cta           String
  evidenceRefs  Json
  createdAt     DateTime @default(now())

  approval Approval?
  outbox   OutboxMessage?

  @@unique([draftId, versionNumber])
  @@index([tenantId])
}

model Approval {
  id               String       @id @default(uuid())
  tenantId         String
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  draftVersionId   String       @unique
  draftVersion     DraftVersion @relation(fields: [draftVersionId], references: [id], onDelete: Cascade)
  approvedByUserId String
  approvedBy       User         @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())

  @@index([tenantId])
}

model OutboxMessage {
  id             String       @id @default(uuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadCaseId     String
  leadCase       LeadCase     @relation(fields: [leadCaseId], references: [id], onDelete: Cascade)
  draftVersionId String       @unique
  draftVersion   DraftVersion @relation(fields: [draftVersionId], references: [id], onDelete: Cascade)
  channel        String
  toEmail        String?
  subject        String
  body           String
  status         String
  sentAt         DateTime
  createdAt      DateTime     @default(now())

  @@index([tenantId])
  @@index([leadCaseId])
}
